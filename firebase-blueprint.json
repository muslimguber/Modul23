{
  "entities": {
    "UserProgress": {
      "title": "User Progress",
      "description": "Stores completion status of modules and pages for each user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The unique ID of the user." },
        "moduleNumber": { "type": "number", "description": "The module number." },
        "completedPages": { "type": "array", "items": { "type": "number" }, "description": "List of completed page IDs." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp." }
      },
      "required": ["userId", "moduleNumber", "completedPages", "updatedAt"]
    },
    "QuizResult": {
      "title": "Quiz Result",
      "description": "Stores history of quiz scores for users.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "userClass": { "type": "string" },
        "quizName": { "type": "string" },
        "score": { "type": "number" },
        "submittedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "userClass", "quizName", "score", "submittedAt"]
    }
  },
  "firestore": {
    "/progress/{progressId}": {
      "schema": "UserProgress",
      "description": "User progress per module."
    },
    "/results/{resultId}": {
      "schema": "QuizResult",
      "description": "Quiz submission history."
    }
  }
}
