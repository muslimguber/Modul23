rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny for everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Progress Collection
    match /progress/{progressId} {
      function isValidProgress(data) {
        return data.userId is string && data.userId.size() <= 128 &&
               data.moduleNumber is number &&
               data.completedPages is list &&
               data.updatedAt is timestamp;
      }

      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && 
                      isValidProgress(request.resource.data) &&
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.updatedAt == request.time;
      
      allow update: if isSignedIn() &&
                      isValidProgress(request.resource.data) &&
                      resource.data.userId == request.auth.uid &&
                      request.resource.data.userId == resource.data.userId &&
                      request.resource.data.updatedAt == request.time &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedPages', 'updatedAt']);
    }

    // Results Collection
    match /results/{resultId} {
      function isValidResult(data) {
        return data.userId is string && data.userId.size() <= 128 &&
               data.name is string && data.name.size() <= 100 &&
               data.userClass is string && data.userClass.size() <= 50 &&
               data.quizName is string && data.quizName.size() <= 200 &&
               data.score is number &&
               data.submittedAt is timestamp;
      }

      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
                      isValidResult(request.resource.data) &&
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.submittedAt == request.time;

      // Results are immutable after creation - no updates
      allow update: if false;
    }
  }
}
